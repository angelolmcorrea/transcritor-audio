# Copie para .env e preencha. NUNCA comite o .env.
GEMINI_API_KEY=
# Opcional: sobrescreve o modelo padrao (gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# Opcional: teto de tamanho do upload em MB (default 100)
# MAX_UPLOAD_MB=100
# Opcional: caminho do binario do ffmpeg (se nao estiver no PATH).
# Ex Windows: C:\ffmpeg\bin\ffmpeg.exe
# FFMPEG_PATH=
# Cookie de sessao secure (true em producao HTTPS; false em HTTP/LAN).
# COOKIE_SECURE=false

# Login da aplicacao (obrigatorio). NUNCA comite os valores reais.
APP_USER=
APP_PASSWORD=
# Chave aleatoria para assinar o cookie de sessao.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
